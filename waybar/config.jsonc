{
"include": [
  "$HOME/.config/waybar/Modules",
  "$HOME/.config/waybar/ModulesWorkspaces",
  "$HOME/.config/waybar/ModulesGroups"
  ],
"layer": "top",
"position": "top",
"exclusive": true,
"passthrough": false,
"gtk-layer-shell": true,
"spacing": 0,
"margin-left": 5,
"margin-right": 5,
"margin-top": 1,

"modules-left": [
	"idle_inhibitor",
	//"group/mobo_drawer",
	"hyprland/workspaces#numbers",
	"tray",
	"mpris",
	],

"modules-center": [
	"clock#2",
	"group/notify",
	],

"modules-right": [
	"hyprland/window",
	"battery",
 	"group/audio",
	"custom/power",
	],
}
